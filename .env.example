# PostgreSQL (server-side only; read by the API route handlers)
DATABASE_URL=postgres://wtfiwant:wtfiwant@localhost:5432/wtfiwant

# Free reflection never calls AI. Paid jobs use `openai`; `local` is a template-only dev adapter.
# Production payments require AI_PROVIDER=openai. Run the report worker alongside web.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_FOLLOWUP_MODEL=gpt-6-luna

# Paid Full Compass (server-side only). The app remains free-checkpoint-only when disabled.
PAYMENTS_ENABLED=false
# Show the instant Checkout test form on /commitment (development only).
PAYMENT_TEST_ENABLED=false
EMAIL_PROVIDER=resend
PUBLIC_APP_URL=http://localhost:3000
TERMS_URL=http://localhost:3000/terms
REFUND_POLICY_URL=http://localhost:3000/refunds
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
RESEND_API_KEY=
REPORT_EMAIL_FROM="wtfiwant (no reply) <report@wtfiwant.app>"

# Optional self-hosted Umami (runtime/server-side; no NEXT_PUBLIC_ variables).
# Create a website in Umami and copy its public Website ID. Use a separate test
# website for testing. Localhost tracking is disabled in code. Generate the hashing secret: openssl rand -hex 32
ANALYTICS_ENABLED=false
UMAMI_URL=https://analytics.awinter.dev
UMAMI_WEBSITE_ID=
ANALYTICS_HASH_SECRET=
