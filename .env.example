# PostgreSQL (used by apps/api)
DATABASE_URL=postgres://wtfiwant:wtfiwant@localhost:5432/wtfiwant
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# `local` keeps all reflection text on your machine. Set `openai` to opt in.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_FOLLOWUP_MODEL=gpt-5-mini

# Browser-visible backend origin (never put secrets in NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_URL=http://localhost:4000
