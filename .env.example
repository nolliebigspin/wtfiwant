# PostgreSQL (server-side only; read by the API route handlers)
DATABASE_URL=postgres://wtfiwant:wtfiwant@localhost:5432/wtfiwant

# `local` keeps all reflection text on your machine. Set `openai` to opt in.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_FOLLOWUP_MODEL=gpt-5-mini

# Paid Full Compass (server-side only). The app remains preview-only when disabled.
PAYMENTS_ENABLED=false
PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
RESEND_API_KEY=
REPORT_EMAIL_FROM=wtfiwant <compass@example.com>
